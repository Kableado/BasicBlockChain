<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Retaining original AssemblyName and RootNamespace for compatibility -->
    <AssemblyName>BasicBlockChain.Core</AssemblyName>
    <RootNamespace>BasicBlockChain.Core</RootNamespace>
  </PropertyGroup>

  <!-- 
    System.Net.Http and other common libraries are included by default with Microsoft.NET.Sdk.
    No explicit references to System.Net or System.Net.Http are usually needed.
    VAR.Json reference is removed as per requirements.
    packages.config is not used with SDK-style projects; package references would go here
    using <PackageReference Include="PackageName" Version="version" /> if any were needed.
  -->

</Project>